# Inside containers, site domains would otherwise resolve to 127.0.0.1 via the host hosts file.
# Answer every name under a local-only TLD with nginx's address; everything else goes to Docker DNS.
# Public TLDs (.dev, .app, ...) are left alone on purpose; .localhost is skipped because curl maps it to loopback itself.
# reload: edits to this file and to the imported runtime files apply within a few seconds.
test local internal lan {
    import /etc/coredns-records/global*.conf
    rewrite name regex (.+)\.(test|local|internal|lan)\.$ nginx_container. answer auto
    forward . 127.0.0.11
    errors
    reload 3s 1s
}
. {
    # Rendered by Manager into runtime/coredns/ (a missing file is fine): query log on/off,
    # custom records, and exact rules for site domains whose TLD is not listed above.
    import /etc/coredns-records/global*.conf
    import /etc/coredns-records/records*.conf
    import /etc/coredns-records/sites*.conf
    # Upstream for external names is the container's own `dns:` (DNS_UPSTREAM in .env).
    forward . 127.0.0.11
    # Not in the zone above, so .test sites see a recreated nginx's new IP right away
    # (custom-TLD sites from sites.conf may lag up to 30s).
    cache 30
    errors
    reload 3s 1s
}

# Host machine, opt-in via scripts/hosts/wildcard_dns.sh (macOS /etc/resolver, Linux systemd-resolved):
# nginx is reachable there on 127.0.0.1, not on its container IP. No .local: it clashes with Bonjour/mDNS.
test:10053 internal:10053 lan:10053 {
    template IN A {
        answer "{{ .Name }} 60 IN A 127.0.0.1"
    }
    # Empty AAAA answer so clients do not wait on IPv6 before falling back to A.
    template IN AAAA {
        rcode NOERROR
    }
    errors
    # Same interval in every block: reload is one Corefile-wide setting.
    reload 3s 1s
}
