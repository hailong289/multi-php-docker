# Optional override used by php-controller
# HOST_PROJECT_PATH=

# Nginx: 1 = create/run the container (Manager sets this when you install Nginx)
# NGINX_SCALE=0
# Host ports published by nginx_container
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# Host ports for optional services (Manager → Services → connection details)
# MYSQL_HOST_PORT=3306
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672
# KAFKA_HOST_PORT=9092
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_WEB_HOST_PORT=8025
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
