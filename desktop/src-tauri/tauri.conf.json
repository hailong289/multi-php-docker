{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi PHP",
  "version": "0.1.0",
  "identifier": "vn.posapp.multiphp",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/copy-stack.mjs",
    "beforeDevCommand": "node scripts/copy-stack.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "stack/": "stack/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRURDQjIxMjJENUY3NUUKUldSZTk5VWlJY3Z0dzJIQXdQaFVtYU00TUQyNjU4Z2dlNHB2d1FCNTFBRjFnQVVOVjFUUHJhaTMK",
      "endpoints": [
        "https://github.com/hailong289/multi-php-docker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
